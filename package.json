{
  "name": "elevate-course-claude-ai-orchestration",
  "private": true,
  "type": "module",
  "description": "Practice environment for the Claude AI Orchestration course: docker safe-autonomy sandbox, API logging proxy, example MCP server, a file-based agent pipeline - and the marked assignment's two red test suites.",
  "scripts": {
    "proxy": "tsx proxy/logproxy.ts",
    "mcp:example": "tsx mcp/example-server.ts",
    "mcp:mine": "tsx mcp/my-server.ts",
    "pipeline": "tsx orchestration/pipeline.ts",
    "decompose": "tsx orchestration/decompose.ts",
    "test": "vitest run",
    "tsc:check": "tsc --noEmit",
    "verify": "pnpm tsc:check && pnpm test",
    "test:shipped": "vitest run --exclude \"tests/gate/**\"",
    "test:gate": "vitest run tests/gate"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.278",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "chokidar": "^4.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.16.1"
}
